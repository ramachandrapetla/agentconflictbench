@@ -74,6 +74,21 @@ def _is_https_redirect(url: URL, location: URL) -> bool:
     )
 
 
+def _is_loopback_https_redirect(url: URL, location: URL) -> bool:
+    """
+    Return 'True' for HTTPS upgrades between loopback URLs.
+    """
+    loopback_hosts = {"localhost", "127.0.0.1"}
+    if url.host not in loopback_hosts or location.host not in loopback_hosts:
+        return False
+
+    return (
+        url.scheme == "http"
+        and location.scheme == "https"
+        and _same_origin(url.copy_with(scheme="https"), location)
+    )
+
+
 def _port_or_default(url: URL) -> int | None:
     if url.port is not None:
         return url.port
@@ -550,7 +565,9 @@ class BaseClient:
         headers = Headers(request.headers)
 
         if not _same_origin(url, request.url):
-            if not _is_https_redirect(request.url, url):
+            if not _is_https_redirect(
+                request.url, url
+            ) and not _is_loopback_https_redirect(request.url, url):
                 # Strip Authorization headers when responses are redirected
                 # away from the origin. (Except for direct HTTP to HTTPS redirects.)
                 headers.pop("Authorization", None)
